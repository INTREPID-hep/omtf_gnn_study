universe    = vanilla
initialdir = $ENV(PWD)
executable  = pipeline/validate.sh
arguments   = $(dataset)

should_transfer_files = NO
getenv = True

request_cpus   = 2
request_memory = 8G
request_disk   = 2G

log    = build/condor/validate_g_full.$(Cluster).$(Process).log
output = build/condor/validate_g_full.$(Cluster).$(Process).out
error  = build/condor/validate_g_full.$(Cluster).$(Process).err

queue dataset in (G1 G2 G3 G4 G5 G6 G7 G8)
