universe    = vanilla
initialdir = $ENV(PWD)
executable  = pipeline/eval_das.sh
should_transfer_files = NO
getenv = True
request_cpus   = 4
request_memory = 16G
request_disk   = 4G
request_gpus   = 1
+UseNvidiaA100 = True
log    = build/condor/das_eval.$(Cluster).$(Process).log
output = build/condor/das_eval.$(Cluster).$(Process).out
error  = build/condor/das_eval.$(Cluster).$(Process).err
queue
